[main]
host = https://www.transifex.com

[o:transmissionbt:p:transmissionbt:r:gtk]
file_filter = po/<lang>.po
source_file = po/en.po
source_lang = en
type        = PO

[o:transmissionbt:p:transmissionbt:r:mac-ql]
file_filter = macosx/QuickLookExtension/<lang>.lproj/Localizable.strings
source_file = macosx/QuickLookExtension/en.lproj/Localizable.strings
source_lang = en
type        = STRINGS
lang_map    = pt_BR: pt-BR, pt_PT: pt-PT, zh_CN: zh-CN, zh_TW: zh-TW
