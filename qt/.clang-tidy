---
# Don't match any files that are not immediately under `qt/`, they are most likely auto generated headers
HeaderFilterRegex: .*/qt/[^/]*$

# Many of these checks are disabled only because the code hasn't been
# cleaned up yet. Pull requests welcomed.
Checks:
  - bugprone-*
  - -bugprone-branch-clone
  - -bugprone-easily-swappable-parameters
  - -bugprone-signed-bitwise # warns for small unsigned types because of integral promotion
  - -bugprone-throwing-static-initialization
  - cert-*
  - -cert-dcl03-c # alias of `misc-static-assert`
  - -cert-dcl37-c # alias of `bugprone-reserved-identifier`
  - -cert-dcl51-cpp # alias of `bugprone-reserved-identifier`
  - -cert-err58-cpp # alias of `bugprone-throwing-static-initialization`
  - -cert-int09-c
  - clang-analyzer-*
  - cppcoreguidelines-*
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  - -cppcoreguidelines-avoid-magic-numbers
  - -cppcoreguidelines-explicit-constructor # alias of `misc-explicit-constructor`
  - -cppcoreguidelines-macro-usage
  - -cppcoreguidelines-narrowing-conversions
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -cppcoreguidelines-owning-memory
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -cppcoreguidelines-use-enum-class
  - google-readability-*
  - google-runtime-operator
  - misc-*
  - -misc-const-correctness # TODO: enable after https://github.com/llvm/llvm-project/issues/236012 is fixed
  - -misc-include-cleaner
  - -misc-multiple-inheritance
  - -misc-no-recursion
  - -misc-non-private-member-variables-in-classes
  - -misc-static-assert # TODO: enable after https://github.com/llvm/llvm-project/issues/213560 is fixed
  - modernize-*
  - -modernize-use-trailing-return-type # keep
  - performance-*
  - portability-*
  - -portability-avoid-pragma-once
  - readability-*
  - -readability-convert-member-functions-to-static
  - -readability-function-cognitive-complexity
  - -readability-identifier-length
  - -readability-implicit-bool-conversion
  - -readability-magic-numbers
  - -readability-redundant-access-specifiers # keep: 'private' vs 'private slots'
  - -readability-redundant-parentheses # TODO: enable after https://github.com/llvm/llvm-project/pull/228666 is released
  - -readability-trailing-comma # Adds too much indentation to `std::array` definitions with 2 braces
  - -readability-use-concise-preprocessor-directives

CheckOptions:
  - { key: cppcoreguidelines-avoid-do-while.IgnoreMacros,                   value: true       }
  - { key: readability-else-after-return.WarnOnConditionVariables,                  value: false      }
  - { key: readability-identifier-naming.ClassCase,                         value: CamelCase  }
  # https://stackoverflow.com/a/49892587/11390656:
  # Qt slot names with underscore has a special meaning, so we don't use lower_case for class method names
  - { key: readability-identifier-naming.ClassMethodCase,                   value: camelBack  }
  - { key: readability-identifier-naming.ConstexprVariableCase,             value: CamelCase  }
  - { key: readability-identifier-naming.GlobalConstantCase,                value: CamelCase  }
  - { key: readability-identifier-naming.MemberConstantCase,                value: CamelCase  }
  - { key: readability-identifier-naming.NamespaceCase,                     value: lower_case }
  - { key: readability-identifier-naming.PrivateMemberSuffix,               value: _          }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,             value: _          }
  - { key: readability-identifier-naming.StaticConstantCase,                value: CamelCase  }
  - { key: readability-identifier-naming.StructCase,                        value: CamelCase  }
  - { key: readability-identifier-naming.TemplateParameterCase,             value: CamelCase  }
  - { key: readability-identifier-naming.VariableCase,                      value: lower_case }
  - { key: readability-implicit-bool-conversion.UseUpperCaseLiteralSuffix,  value: true       }
