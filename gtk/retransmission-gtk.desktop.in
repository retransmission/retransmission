[Desktop Entry]
Name=Transmission
GenericName=BitTorrent Client
Comment=Download and share files over BitTorrent
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=torrents;downloading;uploading;share;sharing;
Exec=@TR_GTK_EXECUTABLE_NAME@ %U
Icon=transmission-gtk
Terminal=false
TryExec=@TR_GTK_EXECUTABLE_NAME@
Type=Application
StartupNotify=true
# What a Wayland compositor matches windows against; CMake substitutes the same
# value the client is built with.
StartupWMClass=@TR_GTK_APP_ID@
MimeType=application/x-bittorrent;x-scheme-handler/magnet;
Categories=Network;FileTransfer;P2P;GTK;
X-AppInstall-Keywords=torrent
Actions=Pause;Minimize;

[Desktop Action Pause]
Name=Start Transmission with All Torrents Paused
Exec=@TR_GTK_EXECUTABLE_NAME@ --paused

[Desktop Action Minimize]
Name=Start Transmission Minimized
Exec=@TR_GTK_EXECUTABLE_NAME@ --minimized
