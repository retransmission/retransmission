---
HeaderFilterRegex: .*/gtk/[^/]*$

Checks:
  - bugprone-*
  - -bugprone-easily-swappable-parameters
  - -bugprone-signed-bitwise # warns for small unsigned types because of integral promotion
  - cert-*
  - -cert-dcl03-c # alias of `misc-static-assert`
  - -cert-dcl37-c # alias of `bugprone-reserved-identifier`
  - -cert-dcl51-cpp # alias of `bugprone-reserved-identifier`
  - -cert-int09-c # alias of `readability-enum-initial-value`
  - clang-analyzer-optin*
  - -clang-analyzer-optin.core.EnumCastOutOfRange # TODO: enable after https://github.com/llvm/llvm-project/issues/179094 is fixed
  - cppcoreguidelines-*
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  - -cppcoreguidelines-avoid-magic-numbers # alias of `readability-magic-numbers`
  - -cppcoreguidelines-avoid-non-const-global-variables
  - -cppcoreguidelines-explicit-constructor # alias of `misc-explicit-constructor`
  - -cppcoreguidelines-narrowing-conversions # alias of `bugprone-narrowing-conversions`
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-use-enum-class
  - misc-*
  - -misc-const-correctness # TODO: enable after https://github.com/llvm/llvm-project/issues/236012 is fixed
  - -misc-include-cleaner
  - -misc-multiple-inheritance
  - -misc-static-assert # TODO: enable after https://github.com/llvm/llvm-project/issues/213560 is fixed
  - modernize-*
  - -modernize-use-trailing-return-type
  - performance-*
  - portability-*
  - -portability-avoid-pragma-once
  - -portability-template-virtual-member-function
  - readability-*
  - -readability-function-cognitive-complexity
  - -readability-identifier-length
  - -readability-magic-numbers
  - -readability-qualified-auto
  - -readability-redundant-access-specifiers
  - -readability-redundant-parentheses # TODO: enable after https://github.com/llvm/llvm-project/pull/228666 is released
  - -readability-trailing-comma # Adds too much indentation to `std::array` definitions with 2 braces
  - -readability-use-concise-preprocessor-directives

CheckOptions:
  - { key: cppcoreguidelines-avoid-do-while.IgnoreMacros, value: true }
  - { key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic, value: true }
  - { key: modernize-pass-by-value.ValuesOnly, value: true }
  - { key: readability-else-after-return.WarnOnConditionVariables, value: false }
  - { key: readability-implicit-bool-conversion.UseUpperCaseLiteralSuffix, value: true }
