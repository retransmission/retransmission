#include "Project.Common.xcconfig"

// Preprocessor and compiler flags
GCC_PREPROCESSOR_DEFINITIONS = BUILD_MAC_CLIENT XCODE_BUILD
OTHER_CFLAGS = $(inherited) -DFMT_HEADER_ONLY -DWITH_CCRYPTO

// Debug settings
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
COPY_PHASE_STRIP = NO
