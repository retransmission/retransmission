# Source files with translatable strings, for xgettext --files-from.
# Run xgettext with GETTEXTDATADIRS=po, so that it reads Qt Designer and Interface Builder files with the rules in po/its/,
# and with these options, which CI reads from the lines that start with "#   -":
#   --from-code=UTF-8 --add-comments=Translators:
#   -k_ -kN_ -kC_:1c,2 -kNC_:1c,2 -kngettext:1,2 -ktr_ngettext:1,2 -ktr_pgettext:1c,2
#   -kTR_TEXT -kTR_TEXT_C:1c,2 -kTR_MNEMONIC -kTR_FORMAT -kTR_FORMAT_N:1,2
#   -kNSLocalizedString:1
#   -kupdateSpinBoxFormat:2,3
# Update each catalog with these msgmerge options.
# They keep source locations, which the template has, out of the catalogs, and leave lines unwrapped:
#   msgmerge --update --no-location --no-wrap --previous po/<language>.po <template>
