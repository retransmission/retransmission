# Source files with translatable strings, for xgettext --files-from.
# Run xgettext with GETTEXTDATADIRS=po, so that it reads Qt Designer files with the rules in po/its/,
# and with these options:
#   --from-code=UTF-8 --add-comments=Translators:
#   -k_ -kN_ -kC_:1c,2 -kNC_:1c,2 -kngettext:1,2 -ktr_ngettext:1,2 -ktr_pgettext:1c,2
#   -kTR_TEXT -kTR_TEXT_C:1c,2 -kTR_MNEMONIC -kTR_FORMAT -kTR_FORMAT_N:1,2
#   -kupdateSpinBoxFormat:2,3
