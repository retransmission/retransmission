msgid "{current_size} ({percent_done}%)"
msgstr "{current_size} ({percent_done}%)"

#. Translators: Text following the "Have:" label in torrent properties dialog;
#. {current_size} is amount of downloaded and verified data,
#. {complete_size} is overall size of torrent data,
#. {percent_done} is percentage ({current_size}/{complete_size}*100)
#. Translators: First part of torrent progress string,
#. {current_size} is how much we've got,
#. {complete_size} is how much we'll have when done,
#. {percent_done} is a percentage of the two
msgid "{current_size} of {complete_size} ({percent_done}%)"
msgstr "{current_size}/{complete_size} ({percent_done}%)"

#. Translators: Text following the "Have:" label in torrent properties dialog;
#. {current_size} is amount of downloaded data (both verified and unverified),
#. {complete_size} is overall size of torrent data,
#. {percent_done} is percentage ({current_size}/{complete_size}*100),
#. {unverified_size} is amount of downloaded but not yet verified data
msgid "{current_size} of {complete_size} ({percent_done}%), {unverified_size} Unverified"
msgstr "{current_size} / {complete_size} ({percent_done}%), {unverified_size} შეუმოწმებელი"

