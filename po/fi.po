#. Translators: Text following the "Have:" label in torrent properties dialog;
#. {current_size} is amount of downloaded and verified data,
#. {complete_size} is overall size of torrent data,
#. {percent_done} is percentage ({current_size}/{complete_size}*100)
#. Translators: First part of torrent progress string,
#. {current_size} is how much we've got,
#. {complete_size} is how much we'll have when done,
#. {percent_done} is a percentage of the two
msgid "{current_size} of {complete_size} ({percent_done}%)"
msgstr "{current_size}/{complete_size} ({percent_done}%)"

#. Translators: First part of torrent progress string,
#. {current_size} is how much we've got,
#. {complete_size} is the torrent's total size,
#. {percent_complete} is a percentage of the two,
#. {uploaded_size} is how much we've uploaded,
#. {ratio} is our upload-to-download ratio,
#. {seed_ratio} is the ratio we want to reach before we stop uploading
msgid "{current_size} of {complete_size} ({percent_complete}%), uploaded {uploaded_size} (Ratio: {ratio}, Goal: {seed_ratio})"
msgstr "{current_size}/{complete_size} ({percent_complete}%), lähetetty {uploaded_size} (Suhde: {ratio}, Tavoite: {seed_ratio})"

#. Translators: First part of torrent progress string,
#. {current_size} is how much we've got,
#. {complete_size} is the torrent's total size,
#. {percent_complete} is a percentage of the two,
#. {uploaded_size} is how much we've uploaded,
#. {ratio} is our upload-to-download ratio
msgid "{current_size} of {complete_size} ({percent_complete}%), uploaded {uploaded_size} (Ratio: {ratio})"
msgstr "{current_size}/{complete_size} ({percent_complete}%), lähetetty {uploaded_size} (Suhde: {ratio})"

#. Translators: First part of torrent progress string,
#. {complete_size} is the torrent's total size,
#. {uploaded_size} is how much we've uploaded,
#. {ratio} is our upload-to-download ratio,
#. {seed_ratio} is the ratio we want to reach before we stop uploading
msgid "{complete_size}, uploaded {uploaded_size} (Ratio: {ratio}, Goal: {seed_ratio})"
msgstr "{complete_size}, lähetetty {uploaded_size} (Suhde: {ratio}, Tavoite: {seed_ratio})"

#. Translators: First part of torrent progress string,
